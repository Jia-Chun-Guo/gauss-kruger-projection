Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"===", "===", 
   RowBox[{"Curves", " ", "of", " ", "k", " ", "and", " ", "\[Gamma]"}], "===",
    "==="}], "*)"}]], "Input",
 CellChangeTimes->{{3.9755566931614947`*^9, 3.975556700190196*^9}, 
   3.9755567353565025`*^9},ExpressionUUID->"29205bd4-b713-4782-a64d-\
dad68a248e34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"k", ":=", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["e", "2"], 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "2"]}]}]], 
      RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]], 
     FractionBox[
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"JacobiSN", "[", 
           RowBox[{"u", ",", 
            SuperscriptBox["e", "2"]}], "]"}], "2"], 
         SuperscriptBox[
          RowBox[{"JacobiDN", "[", 
           RowBox[{"v", ",", 
            RowBox[{"1", "-", 
             SuperscriptBox["e", "2"]}]}], "]"}], "2"]}]}]], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"JacobiDN", "[", 
          RowBox[{"u", ",", 
           SuperscriptBox["e", "2"]}], "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"JacobiDN", "[", 
          RowBox[{"v", ",", 
           RowBox[{"1", "-", 
            SuperscriptBox["e", "2"]}]}], "]"}], "2"], "-", "1"}]]]}], 
    ")"}]}], ";", 
  RowBox[{"\[Gamma]", ":=", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["e", "2"]}], ")"}]}], 
     RowBox[{"JacobiSD", "[", 
      RowBox[{"u", ",", 
       SuperscriptBox["e", "2"]}], "]"}], 
     RowBox[{"JacobiNC", "[", 
      RowBox[{"u", ",", 
       SuperscriptBox["e", "2"]}], "]"}], 
     RowBox[{"JacobiSD", "[", 
      RowBox[{"v", ",", 
       RowBox[{"1", "-", 
        SuperscriptBox["e", "2"]}]}], "]"}], 
     RowBox[{"JacobiCN", "[", 
      RowBox[{"v", ",", 
       RowBox[{"1", "-", 
        SuperscriptBox["e", "2"]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.975556737100607*^9, 3.9755567572366247`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"1ead3593-b322-40a9-ae97-b4ef17fb08da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"k", "/.", 
            RowBox[{"u", "\[Rule]", "u\[Xi]\[Eta]"}]}], "/.", 
           RowBox[{"v", "\[Rule]", "v\[Xi]\[Eta]"}]}], "/.", 
          RowBox[{"\[Xi]", "\[Rule]", 
           RowBox[{"ArcTan", "[", 
            FractionBox[
             RowBox[{"Sinh", "[", "\[Psi]", "]"}], 
             RowBox[{"Cos", "[", "\[Lambda]", "]"}]], "]"}]}]}], "/.", 
         RowBox[{"\[Eta]", "\[Rule]", 
          RowBox[{"ArcTanh", "[", 
           FractionBox[
            RowBox[{"Sin", "[", "\[Lambda]", "]"}], 
            RowBox[{"Cosh", "[", "\[Psi]", "]"}]], "]"}]}]}], "/.", 
        RowBox[{"\[Psi]", "\[Rule]", 
         RowBox[{
          RowBox[{"ArcTanh", "[", 
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "]"}], "-", 
          RowBox[{"e", " ", 
           RowBox[{"ArcTanh", "[", 
            RowBox[{"e", " ", 
             RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], "]"}]}]}]}]}], "/.", 
       RowBox[{"a", "\[Rule]", "6378137"}]}], "/.", 
      RowBox[{"e", "\[Rule]", 
       SqrtBox[
        RowBox[{
         RowBox[{"2", "f"}], "-", 
         SuperscriptBox["f", "2"]}]]}]}], "/.", 
     RowBox[{"n", "\[Rule]", 
      FractionBox["f", 
       RowBox[{"2", "-", "f"}]]}]}], "/.", 
    RowBox[{"f", "\[Rule]", 
     FractionBox["1000000000", "298257222101"]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[CurlyPhi]", ",", "0", ",", 
     FractionBox[
      RowBox[{"89", "\[Pi]"}], "180"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Lambda]", ",", "0", ",", 
     FractionBox[
      RowBox[{"3", "\[Pi]"}], "180"]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
