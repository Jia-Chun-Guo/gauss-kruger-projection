Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["180", "\[Pi]"], "\[Gamma]"}], "/.", 
            RowBox[{"u", "\[Rule]", "u\[Xi]\[Eta]"}]}], "/.", 
           RowBox[{"v", "\[Rule]", "v\[Xi]\[Eta]"}]}], "/.", 
          RowBox[{"\[Xi]", "\[Rule]", 
           RowBox[{"ArcTan", "[", 
            FractionBox[
             RowBox[{"Sinh", "[", "\[Psi]", "]"}], 
             RowBox[{"Cos", "[", "\[Lambda]", "]"}]], "]"}]}]}], "/.", 
         RowBox[{"\[Eta]", "\[Rule]", 
          RowBox[{"ArcTanh", "[", 
           FractionBox[
            RowBox[{"Sin", "[", "\[Lambda]", "]"}], 
            RowBox[{"Cosh", "[", "\[Psi]", "]"}]], "]"}]}]}], "/.", 
        RowBox[{"\[Psi]", "\[Rule]", 
         RowBox[{
          RowBox[{"ArcTanh", "[", 
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "]"}], "-", 
          RowBox[{"e", " ", 
           RowBox[{"ArcTanh", "[", 
            RowBox[{"e", " ", 
             RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], "]"}]}]}]}]}], "/.", 
       RowBox[{"a", "\[Rule]", "6378137"}]}], "/.", 
      RowBox[{"e", "\[Rule]", 
       SqrtBox[
        RowBox[{
         RowBox[{"2", "f"}], "-", 
         SuperscriptBox["f", "2"]}]]}]}], "/.", 
     RowBox[{"n", "\[Rule]", 
      FractionBox["f", 
       RowBox[{"2", "-", "f"}]]}]}], "/.", 
    RowBox[{"f", "\[Rule]", 
     FractionBox["1000000000", "298257222101"]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[CurlyPhi]", ",", "0", ",", 
     FractionBox[
      RowBox[{"89", "\[Pi]"}], "180"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Lambda]", ",", "0", ",", 
     FractionBox[
      RowBox[{"3", "\[Pi]"}], "180"]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
