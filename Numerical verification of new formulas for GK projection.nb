  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xq3", "-", "x"}], ")"}], "/.", 
            RowBox[{"u", "\[Rule]", "u\[Xi]\[Eta]"}]}], "/.", 
           RowBox[{"v", "\[Rule]", "v\[Xi]\[Eta]"}]}], "/.", 
          RowBox[{"\[Xi]", "\[Rule]", 
           RowBox[{"ArcTan", "[", 
            FractionBox[
             RowBox[{"Sinh", "[", "\[Psi]", "]"}], 
             RowBox[{"Cos", "[", "\[Lambda]", "]"}]], "]"}]}]}], "/.", 
         RowBox[{"\[Eta]", "\[Rule]", 
          RowBox[{"ArcTanh", "[", 
           FractionBox[
            RowBox[{"Sin", "[", "\[Lambda]", "]"}], 
            RowBox[{"Cosh", "[", "\[Psi]", "]"}]], "]"}]}]}], "/.", 
        RowBox[{"\[Psi]", "\[Rule]", 
         RowBox[{
          RowBox[{"ArcTanh", "[", 
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "]"}], "-", 
          RowBox[{"e", " ", 
           RowBox[{"ArcTanh", "[", 
            RowBox[{"e", " ", 
             RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], "]"}]}]}]}]}], "/.", 
       RowBox[{"a", "\[Rule]", "6378137"}]}], "/.", 
      RowBox[{"e", "\[Rule]", 
       SqrtBox[
        RowBox[{
         RowBox[{"2", "f"}], "-", 
         SuperscriptBox["f", "2"]}]]}]}], "/.", 
     RowBox[{"n", "\[Rule]", 
      FractionBox["f", 
       RowBox[{"2", "-", "f"}]]}]}], "/.", 
    RowBox[{"f", "\[Rule]", 
