  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"xq6", "-", "x"}], ")"}], "/.", 
            RowBox[{"u", "\[Rule]", "u\[Xi]\[Eta]"}]}], "/.", 
           RowBox[{"v", "\[Rule]", "v\[Xi]\[Eta]"}]}], "/.", 
          RowBox[{"\[Xi]", "\[Rule]", 
           RowBox[{"ArcTan", "[", 
